
import cv2
import numpy as np
import time

# =========================
# Camera setup
# =========================

cap = cv2.VideoCapture(1, cv2.CAP_DSHOW)

if not cap.isOpened():
    print("Cannot open camera")
    raise SystemExit

cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)
cap.set(cv2.CAP_PROP_FPS, 60)
cap.set(cv2.CAP_PROP_BUFFERSIZE, 1)

# =========================
# Color settings
# =========================

colors = {
    "Yellow": ([20, 100, 100], [38, 255, 255]),
    "Purple": ([120, 65, 70], [150, 255, 255]),
    "Blue": ([100, 100, 70], [119, 255, 255])
}

box_colors = {
    "Yellow": (0, 255, 255),
    "Purple": (255, 0, 255),
    "Blue": (255, 0, 0)
}

# =========================
# Tracking settings
# =========================

tracked_objects = {}
next_id = 0

MAX_DISTANCE = 220
MAX_MISSING = 6

# Detection zone around the line
ZONE_SIZE = 25

counts = {
    "Yellow": 0,
    "Purple": 0,
    "Blue": 0
}

previous_time = time.perf_counter()

kernel = np.ones((3, 3), np.uint8)

# =========================
# Main loop
# =========================

while True:

    ret, frame = cap.read()

    if not ret:
        print("Cannot read camera frame")
        break

    height, width = frame.shape[:2]

    line_y = height // 2

    upper_zone = line_y - ZONE_SIZE
    lower_zone = line_y + ZONE_SIZE

    hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)

    detections = []

    # =========================
    # Color detection
    # =========================

    for name, (lower, upper) in colors.items():

        mask = cv2.inRange(
            hsv,
            np.array(lower, dtype=np.uint8),
            np.array(upper, dtype=np.uint8)
        )

        mask = cv2.morphologyEx(
            mask,
            cv2.MORPH_OPEN,
            kernel
        )

        contours, _ = cv2.findContours(
            mask,
            cv2.RETR_EXTERNAL,
            cv2.CHAIN_APPROX_SIMPLE
        )

        for contour in contours:

            area = cv2.contourArea(contour)

            if area < 300:
                continue

            x, y, w, h = cv2.boundingRect(contour)

            cx = x + w // 2
            cy = y + h // 2

            detections.append({
                "name": name,
                "x": cx,
                "y": cy,
                "box": (x, y, w, h)
            })

    # =========================
    # Object tracking
    # =========================

    candidates = []

    for obj_id, obj in tracked_objects.items():

        # Predict next position
        predicted_x = obj["x"] + obj["vx"]
        predicted_y = obj["y"] + obj["vy"]

        for i, det in enumerate(detections):

            if obj["name"] != det["name"]:
                continue

            dx = det["x"] - predicted_x
            dy = det["y"] - predicted_y

            distance = (dx ** 2 + dy ** 2) ** 0.5

            if distance <= MAX_DISTANCE:
                candidates.append(
                    (distance, obj_id, i)
                )

    candidates.sort()

    matched_ids = set()
    matched_detections = set()

    for distance, obj_id, i in candidates:

        if obj_id in matched_ids:
            continue

        if i in matched_detections:
            continue

        obj = tracked_objects[obj_id]
        det = detections[i]

        previous_y = obj["y"]
        current_y = det["y"]

        # Update velocity
        obj["vx"] = det["x"] - obj["x"]
        obj["vy"] = det["y"] - obj["y"]

        # Bottom-to-top crossing detection
        crossed_line = (
            previous_y > line_y
            and current_y <= line_y
        )

        # Detection zone crossing
        crossed_zone = (
            previous_y > lower_zone
            and current_y <= upper_zone
        )

        if (
            (crossed_line or crossed_zone)
            and not obj["counted"]
        ):

            counts[det["name"]] += 1
            obj["counted"] = True

            print(
                f"SEND TO ESP32: {det['name'].upper()} "
                f"(ID: {obj_id})"
            )

        obj["x"] = det["x"]
        obj["y"] = det["y"]
        obj["missing"] = 0

        matched_ids.add(obj_id)
        matched_detections.add(i)

    # =========================
    # Register new objects
    # =========================

    new_ids = set()

    for i, det in enumerate(detections):

        if i in matched_detections:
            continue

        tracked_objects[next_id] = {
            "name": det["name"],
            "x": det["x"],
            "y": det["y"],
            "vx": 0,
            "vy": 0,
            "missing": 0,
            "counted": False
        }

        new_ids.add(next_id)
        next_id += 1

    # =========================
    # Remove missing objects
    # =========================

    for obj_id in list(tracked_objects.keys()):

        if obj_id in matched_ids:
            continue

        if obj_id in new_ids:
            continue

        tracked_objects[obj_id]["missing"] += 1

        if tracked_objects[obj_id]["missing"] > MAX_MISSING:
            del tracked_objects[obj_id]

    # =========================
    # Draw detections
    # =========================

    for det in detections:

        name = det["name"]
        cx = det["x"]
        cy = det["y"]

        x, y, w, h = det["box"]

        cv2.rectangle(
            frame,
            (x, y),
            (x + w, y + h),
            box_colors[name],
            2
        )

        cv2.circle(
            frame,
            (cx, cy),
            4,
            (255, 255, 255),
            -1
        )

        cv2.putText(
            frame,
            name,
            (x, max(y - 10, 0)),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.6,
            box_colors[name],
            2
        )

    # =========================
    # Draw detection zone
    # =========================

    cv2.line(
        frame,
        (0, line_y),
        (width, line_y),
        (255, 255, 255),
        2
    )

    cv2.line(
        frame,
        (0, upper_zone),
        (width, upper_zone),
        (0, 255, 0),
        1
    )

    cv2.line(
        frame,
        (0, lower_zone),
        (width, lower_zone),
        (0, 255, 0),
        1
    )

    # =========================
    # Display counters
    # =========================

    y_pos = 30

    for name, count in counts.items():

        cv2.putText(
            frame,
            f"{name}: {count}",
            (10, y_pos),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.7,
            box_colors[name],
            2
        )

        y_pos += 30

    # =========================
    # FPS calculation
    # =========================

    current_time = time.perf_counter()
    elapsed = current_time - previous_time

    fps = 1.0 / elapsed if elapsed > 0 else 0

    previous_time = current_time

    cv2.putText(
        frame,
        f"FPS: {fps:.1f}",
        (width - 140, 30),
        cv2.FONT_HERSHEY_SIMPLEX,
        0.7,
        (255, 255, 255),
        2
    )

    cv2.imshow(
        "Color Sorting Detection",
        frame
    )

    if cv2.waitKey(1) & 0xFF == ord("q"):
        break

cap.release()
cv2.destroyAllWindows()
