
import cv2
import numpy as np
import time

print("Starting combined puck detection and speed measurement...")

# =========================
# Camera setup
# =========================

cap = cv2.VideoCapture(0, cv2.CAP_DSHOW)

if not cap.isOpened():
    print("Cannot open camera!")
    raise SystemExit

cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)
cap.set(cv2.CAP_PROP_FPS, 60)
cap.set(cv2.CAP_PROP_BUFFERSIZE, 1)

# =========================
# Colour settings
# =========================

colors = {
    "Yellow": ([20, 100, 100], [38, 255, 255]),
    "Purple": ([120, 65, 70], [150, 255, 255]),
    "Blue": ([100, 100, 70], [119, 255, 255])
}

box_colors = {
    "Yellow": (0, 255, 255),
    "Purple": (255, 0, 255),
    "Blue": (255, 0, 0)
}

# =========================
# Tracking settings
# =========================

tracked_objects = {}
next_id = 0

MAX_DISTANCE = 220
MAX_MISSING = 6
MIN_AREA = 300

ZONE_SIZE = 25

# =========================
# Speed calibration
# =========================

MEASURED_DISTANCE_CM = 13.0

# =========================
# Counters
# =========================

counts = {
    "Yellow": 0,
    "Purple": 0,
    "Blue": 0
}

previous_time = time.perf_counter()

kernel = np.ones((3, 3), np.uint8)

print("Camera started!")
print("Press Q to quit")
print("Press R to reset")

# =========================
# Main loop
# =========================

while True:

    ret, frame = cap.read()

    if not ret:
        print("Cannot read camera frame")
        break

    current_time = time.perf_counter()

    height, width = frame.shape[:2]

    # White counting line
    line_y = height // 2

    upper_zone = line_y - ZONE_SIZE
    lower_zone = line_y + ZONE_SIZE

    # Distance conversion
    cm_per_pixel = MEASURED_DISTANCE_CM / (height - line_y)

    hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)

    detections = []

    # =========================
    # Colour detection
    # =========================

    for name, (lower, upper) in colors.items():

        mask = cv2.inRange(
            hsv,
            np.array(lower, dtype=np.uint8),
            np.array(upper, dtype=np.uint8)
        )

        mask = cv2.morphologyEx(
            mask,
            cv2.MORPH_OPEN,
            kernel
        )

        contours, _ = cv2.findContours(
            mask,
            cv2.RETR_EXTERNAL,
            cv2.CHAIN_APPROX_SIMPLE
        )

        for contour in contours:

            area = cv2.contourArea(contour)

            if area < MIN_AREA:
                continue

            x, y, w, h = cv2.boundingRect(contour)

            cx = x + w // 2
            cy = y + h // 2

            detections.append({
                "name": name,
                "x": cx,
                "y": cy,
                "box": (x, y, w, h)
            })

    # =========================
    # Object tracking
    # =========================

    candidates = []

    for obj_id, obj in tracked_objects.items():

        predicted_x = obj["x"] + obj["vx"]
        predicted_y = obj["y"] + obj["vy"]

        for i, det in enumerate(detections):

            if obj["name"] != det["name"]:
                continue

            dx = det["x"] - predicted_x
            dy = det["y"] - predicted_y

            distance = (dx ** 2 + dy ** 2) ** 0.5

            if distance <= MAX_DISTANCE:
                candidates.append((distance, obj_id, i))

    candidates.sort()

    matched_ids = set()
    matched_detections = set()
    detection_ids = {}

    # =========================
    # Match existing objects
    # =========================

    for distance, obj_id, i in candidates:

        if obj_id in matched_ids:
            continue

        if i in matched_detections:
            continue

        obj = tracked_objects[obj_id]
        det = detections[i]

        previous_y = obj["y"]
        current_y = det["y"]

        # Update movement prediction
        obj["vx"] = det["x"] - obj["x"]
        obj["vy"] = det["y"] - obj["y"]

        # =========================
        # Start speed measurement
        # =========================

        if current_y > line_y and obj["start_time"] is None:

            obj["start_y"] = current_y
            obj["start_time"] = current_time

        # =========================
        # Detect crossing of white line
        # =========================

        crossed_line = (
            previous_y > line_y
            and current_y <= line_y
        )

        if (
            crossed_line
            and obj["start_time"] is not None
            and not obj["counted"]
        ):

            time_taken = current_time - obj["start_time"]

            distance_pixels = abs(
                obj["start_y"] - line_y
            )

            distance_cm = distance_pixels * cm_per_pixel

            if time_taken > 0:

                speed_cm_s = distance_cm / time_taken

                obj["speed"] = speed_cm_s

                print(
                    f"SPEED: {det['name']} "
                    f"| ID: {obj_id} "
                    f"| {speed_cm_s:.2f} cm/s "
                    f"| Time: {time_taken:.3f} seconds"
                )

            obj["counted"] = True

            counts[det["name"]] += 1

            print(
                f"COUNTED: {det['name']} "
                f"| ID: {obj_id} "
                f"| Total: {counts[det['name']]}"
            )

            # Simulated ESP32 commands

            if det["name"] == "Blue":
                print("SEND TO ESP32: SORT_BLUE")

            elif det["name"] == "Purple":
                print("SEND TO ESP32: SORT_PURPLE")

        # Update position
        obj["x"] = det["x"]
        obj["y"] = det["y"]
        obj["missing"] = 0

        matched_ids.add(obj_id)
        matched_detections.add(i)

        detection_ids[i] = obj_id

    # =========================
    # Register new objects
    # =========================

    new_ids = set()

    for i, det in enumerate(detections):

        if i in matched_detections:
            continue

        ready = det["y"] > line_y

        tracked_objects[next_id] = {
            "name": det["name"],
            "x": det["x"],
            "y": det["y"],
            "vx": 0,
            "vy": 0,
            "missing": 0,
            "counted": False,

            # Speed information
            "start_y": det["y"] if ready else None,
            "start_time": current_time if ready else None,
            "speed": None
        }

        detection_ids[i] = next_id

        new_ids.add(next_id)

        next_id += 1

    # =========================
    # Remove missing objects
    # =========================

    for obj_id in list(tracked_objects.keys()):

        if obj_id in matched_ids:
            continue

        if obj_id in new_ids:
            continue

        tracked_objects[obj_id]["missing"] += 1

        if tracked_objects[obj_id]["missing"] > MAX_MISSING:
            del tracked_objects[obj_id]

    # =========================
    # Draw detections and speed
    # =========================

    for i, det in enumerate(detections):

        name = det["name"]

        x, y, w, h = det["box"]

        cx = det["x"]
        cy = det["y"]

        obj_id = detection_ids.get(i)

        if obj_id is None:
            continue

        obj = tracked_objects[obj_id]

        # Draw bounding box
        cv2.rectangle(
            frame,
            (x, y),
            (x + w, y + h),
            box_colors[name],
            2
        )

        # Draw centre
        cv2.circle(
            frame,
            (cx, cy),
            4,
            (255, 255, 255),
            -1
        )

        # Object label
        label = f"{name} ID:{obj_id}"

        cv2.putText(
            frame,
            label,
            (x, max(20, y - 10)),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.5,
            box_colors[name],
            2
        )

        # Display speed
        if obj["speed"] is not None:

            speed_label = f"{obj['speed']:.1f} cm/s"

            cv2.putText(
                frame,
                speed_label,
                (x, min(height - 10, y + h + 20)),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.6,
                (0, 255, 0),
                2
            )

        elif obj["start_time"] is not None:

            cv2.putText(
                frame,
                "Measuring...",
                (x, min(height - 10, y + h + 20)),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.5,
                (0, 255, 255),
                2
            )

    # =========================
    # Draw measurement lines
    # =========================

    cv2.line(
        frame,
        (0, line_y),
        (width, line_y),
        (255, 255, 255),
        2
    )

    cv2.line(
        frame,
        (0, upper_zone),
        (width, upper_zone),
        (0, 255, 0),
        1
    )

    cv2.line(
        frame,
        (0, lower_zone),
        (width, lower_zone),
        (0, 255, 0),
        1
    )

    cv2.putText(
        frame,
        "13 cm measurement endpoint",
        (10, height - 15),
        cv2.FONT_HERSHEY_SIMPLEX,
        0.5,
        (0, 165, 255),
        2
    )

    # =========================
    # Display counters
    # =========================

    y_pos = 30

    for name, count in counts.items():

        cv2.putText(
            frame,
            f"{name}: {count}",
            (10, y_pos),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.7,
            box_colors[name],
            2
        )

        y_pos += 30

    # =========================
    # FPS calculation
    # =========================

    elapsed = time.perf_counter() - previous_time

    fps = 1.0 / elapsed if elapsed > 0 else 0

    previous_time = time.perf_counter()

    cv2.putText(
        frame,
        f"FPS: {fps:.1f}",
        (width - 140, 30),
        cv2.FONT_HERSHEY_SIMPLEX,
        0.7,
        (255, 255, 255),
        2
    )

    cv2.imshow(
        "Combined Puck Detection and Speed",
        frame
    )

    # =========================
    # Keyboard controls
    # =========================

    key = cv2.waitKey(1) & 0xFF

    if key == ord("q"):
        break

    if key == ord("r"):

        for name in counts:
            counts[name] = 0

        tracked_objects.clear()
        next_id = 0

        print("Counters and tracking reset")

# =========================
# Close camera
# =========================

cap.release()
cv2.destroyAllWindows()

print("Detection finished!")
