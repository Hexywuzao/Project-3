
import cv2
import numpy as np
import time

print("Starting puck detection V3...")

# Run in terminal: py puck_detection_v3.py

# =========================
# Camera setup
# =========================

CAMERA_INDEX = 1

cap = cv2.VideoCapture(CAMERA_INDEX, cv2.CAP_DSHOW)

if not cap.isOpened():
    print("Cannot open camera")
    raise SystemExit

cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)
cap.set(cv2.CAP_PROP_FPS, 60)
cap.set(cv2.CAP_PROP_BUFFERSIZE, 1)

# =========================
# Colour settings
# =========================

colors = {
    "Yellow": ([10, 30, 50], [45, 255, 255]),
    "Purple": ([120, 65, 70], [150, 255, 255]),
    "Blue": ([100, 100, 70], [119, 255, 255])
}

lower_white = np.array([0, 0, 150], dtype=np.uint8)
upper_white = np.array([179, 65, 255], dtype=np.uint8)

box_colors = {
    "Yellow": (0, 255, 255),
    "Purple": (255, 0, 255),
    "Blue": (255, 0, 0)
}

# =========================
# Yellow filtering settings
# =========================

MIN_YELLOW_AREA = 500
MAX_YELLOW_AREA = 3500

MIN_ASPECT_RATIO = 0.65
MAX_ASPECT_RATIO = 1.50

MIN_CIRCULARITY = 0.55

ROI_LEFT = 0.30
ROI_RIGHT = 0.70

MIN_OTHER_AREA = 300

# =========================
# Tracking settings
# =========================

tracked_objects = {}
next_id = 0

MAX_DISTANCE = 220
MAX_MISSING = 6
ZONE_SIZE = 25

# =========================
# Speed calibration
# =========================

MEASURED_DISTANCE_CM = 13.0

# =========================
# Counters
# =========================

counts = {
    "Yellow": 0,
    "Purple": 0,
    "Blue": 0
}

previous_time = time.perf_counter()

kernel = np.ones((3, 3), np.uint8)

SHOW_YELLOW_MASK = False
SHOW_ROI = True

print("Camera started")
print("Q: Quit")
print("R: Reset")
print("M: Toggle yellow mask")
print("V: Toggle ROI")

# =========================
# Main loop
# =========================

while True:

    ret, frame = cap.read()

    if not ret:
        print("Cannot read camera frame")
        break

    current_time = time.perf_counter()

    height, width = frame.shape[:2]

    line_y = height // 2

    upper_zone = line_y - ZONE_SIZE
    lower_zone = line_y + ZONE_SIZE

    cm_per_pixel = (
        MEASURED_DISTANCE_CM / (height - line_y)
    )

    roi_x_min = int(width * ROI_LEFT)
    roi_x_max = int(width * ROI_RIGHT)

    hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)

    detections = []

    # =========================
    # Colour detection
    # =========================

    for name, (lower, upper) in colors.items():

        mask = cv2.inRange(
            hsv,
            np.array(lower, dtype=np.uint8),
            np.array(upper, dtype=np.uint8)
        )

        # Combine yellow and white masks
        if name == "Yellow":

            white_mask = cv2.inRange(
                hsv,
                lower_white,
                upper_white
            )

            mask = cv2.bitwise_or(
                mask,
                white_mask
            )

            # Exclude metal rails outside the ROI
            mask[:, :roi_x_min] = 0
            mask[:, roi_x_max:] = 0

        # Remove small noise
        mask = cv2.morphologyEx(
            mask,
            cv2.MORPH_OPEN,
            kernel
        )

        if name == "Yellow" and SHOW_YELLOW_MASK:

            cv2.imshow(
                "Combined Yellow Mask",
                mask
            )

        contours, _ = cv2.findContours(
            mask,
            cv2.RETR_EXTERNAL,
            cv2.CHAIN_APPROX_SIMPLE
        )

        # =========================
        # Contour filtering
        # =========================

        for contour in contours:

            area = cv2.contourArea(contour)

            x, y, w, h = cv2.boundingRect(contour)

            if w == 0 or h == 0:
                continue

            # Yellow-specific filtering
            if name == "Yellow":

                # Area filtering
                if not (
                    MIN_YELLOW_AREA
                    <= area
                    <= MAX_YELLOW_AREA
                ):
                    continue

                # Aspect ratio filtering
                aspect_ratio = w / h

                if not (
                    MIN_ASPECT_RATIO
                    <= aspect_ratio
                    <= MAX_ASPECT_RATIO
                ):
                    continue

                # Circularity filtering
                perimeter = cv2.arcLength(
                    contour,
                    True
                )

                if perimeter <= 0:
                    continue

                circularity = (
                    4 * np.pi * area
                    / (perimeter ** 2)
                )

                if circularity < MIN_CIRCULARITY:
                    continue

            # Original blue and purple filtering
            else:

                if area < MIN_OTHER_AREA:
                    continue

            cx = x + w // 2
            cy = y + h // 2

            detections.append({
                "name": name,
                "x": cx,
                "y": cy,
                "box": (x, y, w, h),
                "area": area
            })

    # =========================
    # Object tracking
    # =========================

    candidates = []

    for obj_id, obj in tracked_objects.items():

        predicted_x = obj["x"] + obj["vx"]
        predicted_y = obj["y"] + obj["vy"]

        for i, det in enumerate(detections):

            if obj["name"] != det["name"]:
                continue

            dx = det["x"] - predicted_x
            dy = det["y"] - predicted_y

            distance = (
                dx ** 2 + dy ** 2
            ) ** 0.5

            if distance <= MAX_DISTANCE:

                candidates.append(
                    (distance, obj_id, i)
                )

    candidates.sort()

    matched_ids = set()
    matched_detections = set()
    detection_ids = {}

    # =========================
    # Match existing objects
    # =========================

    for distance, obj_id, i in candidates:

        if obj_id in matched_ids:
            continue

        if i in matched_detections:
            continue

        obj = tracked_objects[obj_id]
        det = detections[i]

        current_y = det["y"]

        obj["vx"] = det["x"] - obj["x"]
        obj["vy"] = det["y"] - obj["y"]

        # Start speed measurement
        if current_y > line_y:

            obj["ready"] = True

            if obj["start_time"] is None:

                obj["start_y"] = current_y
                obj["start_time"] = current_time

        # =========================
        # Line crossing and counting
        # =========================

        crossed_line = (
            obj["ready"]
            and current_y <= line_y
            and not obj["counted"]
        )

        if crossed_line:

            obj["counted"] = True

            counts[det["name"]] += 1

            print(
                f"COUNTED: {det['name']} "
                f"| ID: {obj_id} "
                f"| Total: {counts[det['name']]}"
            )

            # =========================
            # Speed measurement
            # =========================

            if obj["start_time"] is not None:

                time_taken = (
                    current_time
                    - obj["start_time"]
                )

                distance_pixels = abs(
                    obj["start_y"] - line_y
                )

                distance_cm = (
                    distance_pixels * cm_per_pixel
                )

                if time_taken > 0:

                    speed_cm_s = (
                        distance_cm / time_taken
                    )

                    obj["speed"] = speed_cm_s

                    print(
                        f"SPEED: {det['name']} "
                        f"| ID: {obj_id} "
                        f"| {speed_cm_s:.2f} cm/s "
                        f"| Time: {time_taken:.3f} s"
                    )

            # =========================
            # Simulated ESP32 commands
            # =========================

            if det["name"] == "Blue":

                print("SEND TO ESP32: SORT_BLUE")

            elif det["name"] == "Purple":

                print("SEND TO ESP32: SORT_PURPLE")

            elif det["name"] == "Yellow":

                print("YELLOW: DEFAULT PATH")

        # Update tracked object
        obj["x"] = det["x"]
        obj["y"] = det["y"]
        obj["missing"] = 0

        matched_ids.add(obj_id)
        matched_detections.add(i)

        detection_ids[i] = obj_id

    # =========================
    # Register new objects
    # =========================

    new_ids = set()

    for i, det in enumerate(detections):

        if i in matched_detections:
            continue

        ready = det["y"] > line_y

        tracked_objects[next_id] = {
            "name": det["name"],
            "x": det["x"],
            "y": det["y"],
            "vx": 0,
            "vy": 0,
            "missing": 0,
            "ready": ready,
            "counted": False,
            "start_y": det["y"] if ready else None,
            "start_time": current_time if ready else None,
            "speed": None
        }

        detection_ids[i] = next_id

        new_ids.add(next_id)

        next_id += 1

    # =========================
    # Remove missing objects
    # =========================

    for obj_id in list(tracked_objects.keys()):

        if obj_id in matched_ids:
            continue

        if obj_id in new_ids:
            continue

        tracked_objects[obj_id]["missing"] += 1

        if (
            tracked_objects[obj_id]["missing"]
            > MAX_MISSING
        ):

            del tracked_objects[obj_id]

    # =========================
    # Draw detections
    # =========================

    for i, det in enumerate(detections):

        name = det["name"]

        x, y, w, h = det["box"]

        cx = det["x"]
        cy = det["y"]

        obj_id = detection_ids.get(i)

        if obj_id is None:
            continue

        obj = tracked_objects[obj_id]

        cv2.rectangle(
            frame,
            (x, y),
            (x + w, y + h),
            box_colors[name],
            2
        )

        cv2.circle(
            frame,
            (cx, cy),
            4,
            (255, 255, 255),
            -1
        )

        if obj["counted"]:

            status = "COUNTED"

        elif obj["ready"]:

            status = "READY"

        else:

            status = "WAIT"

        label = f"{name} ID:{obj_id} {status}"

        cv2.putText(
            frame,
            label,
            (max(0, x - 10), max(20, y - 10)),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.5,
            box_colors[name],
            2
        )

        # Display contour area
        cv2.putText(
            frame,
            f"Area: {det['area']:.0f}",
            (x, min(height - 10, y + h + 15)),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.45,
            box_colors[name],
            1
        )

        # Display speed
        if obj["speed"] is not None:

            speed_label = (
                f"{obj['speed']:.1f} cm/s"
            )

            cv2.putText(
                frame,
                speed_label,
                (x, min(height - 10, y + h + 35)),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.6,
                (0, 255, 0),
                2
            )

        elif obj["start_time"] is not None:

            cv2.putText(
                frame,
                "Measuring...",
                (x, min(height - 10, y + h + 35)),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.5,
                (0, 255, 255),
                2
            )

    # =========================
    # Draw yellow ROI
    # =========================

    if SHOW_ROI:

        cv2.rectangle(
            frame,
            (roi_x_min, 0),
            (roi_x_max - 1, height - 1),
            (0, 165, 255),
            1
        )

        cv2.putText(
            frame,
            "Yellow ROI",
            (roi_x_min + 5, 20),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.5,
            (0, 165, 255),
            1
        )

    # =========================
    # Draw measurement lines
    # =========================

    cv2.line(
        frame,
        (0, line_y),
        (width, line_y),
        (255, 255, 255),
        2
    )

    cv2.line(
        frame,
        (0, upper_zone),
        (width, upper_zone),
        (0, 255, 0),
        1
    )

    cv2.line(
        frame,
        (0, lower_zone),
        (width, lower_zone),
        (0, 255, 0),
        1
    )

    cv2.putText(
        frame,
        "13 cm measurement region",
        (10, height - 15),
        cv2.FONT_HERSHEY_SIMPLEX,
        0.5,
        (0, 165, 255),
        2
    )

    # =========================
    # Display counters
    # =========================

    y_pos = 30

    for name, count in counts.items():

        cv2.putText(
            frame,
            f"{name}: {count}",
            (10, y_pos),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.7,
            box_colors[name],
            2
        )

        y_pos += 30

    total_count = sum(counts.values())

    cv2.putText(
        frame,
        f"Total: {total_count}",
        (10, y_pos),
        cv2.FONT_HERSHEY_SIMPLEX,
        0.7,
        (255, 255, 255),
        2
    )

    # =========================
    # FPS calculation
    # =========================

    elapsed = current_time - previous_time

    fps = 1.0 / elapsed if elapsed > 0 else 0

    previous_time = current_time

    cv2.putText(
        frame,
        f"FPS: {fps:.1f}",
        (width - 140, 30),
        cv2.FONT_HERSHEY_SIMPLEX,
        0.7,
        (255, 255, 255),
        2
    )

    # =========================
    # Display camera
    # =========================

    cv2.imshow(
        "Puck Detection V3",
        frame
    )

    # =========================
    # Keyboard controls
    # =========================

    key = cv2.waitKey(1) & 0xFF

    if key == ord("q"):
        break

    elif key == ord("r"):

        for name in counts:
            counts[name] = 0

        tracked_objects.clear()

        next_id = 0

        print("Counters and tracking reset")

    elif key == ord("m"):

        SHOW_YELLOW_MASK = not SHOW_YELLOW_MASK

        if not SHOW_YELLOW_MASK:

            try:
                cv2.destroyWindow(
                    "Combined Yellow Mask"
                )
            except cv2.error:
                pass

    elif key == ord("v"):

        SHOW_ROI = not SHOW_ROI

# =========================
# Close camera
# =========================

cap.release()
cv2.destroyAllWindows()

print("Detection finished")
