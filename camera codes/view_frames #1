
import cv2

cap = cv2.VideoCapture("conveyor.mp4")

fps = cap.get(cv2.CAP_PROP_FPS)
total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))

frame_number = 0

print("FPS:", fps)
print("Total frames:", total_frames)
print("Controls:")
print("N = Next frame")
print("B = Previous frame")
print("Q = Quit")

while True:

    cap.set(cv2.CAP_PROP_POS_FRAMES, frame_number)

    ret, frame = cap.read()

    if not ret:
        break

    cv2.putText(
        frame,
        f"Frame: {frame_number} | Time: {frame_number/fps:.2f}s",
        (10, 30),
        cv2.FONT_HERSHEY_SIMPLEX,
        0.7,
        (0, 255, 0),
        2
    )

    cv2.imshow("Video Frame Viewer", frame)

    key = cv2.waitKey(0) & 0xFF

    if key == ord('n'):
        frame_number = min(frame_number + 1, total_frames - 1)

    elif key == ord('b'):
        frame_number = max(frame_number - 1, 0)

    elif key == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()
